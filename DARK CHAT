
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DARK CHAT</title>
<style>
*{box-sizing:border-box}
body{
margin:0;background:#080808;color:white;
font-family:Arial,sans-serif;
}
header{
padding:20px;background:#111;
border-bottom:1px solid #292929;
font-size:23px;font-weight:bold;
}
header span{color:#999}
#messages{
height:75vh;overflow-y:auto;
padding:18px;
display:flex;flex-direction:column;gap:12px;
}
.msg{
background:#252525;padding:12px 16px;
border-radius:16px;max-width:80%;
align-self:flex-start;
}
.mine{
background:#444;align-self:flex-end;
}
footer{
position:fixed;bottom:0;width:100%;
display:flex;padding:12px;gap:8px;
background:#111;
}
input{
flex:1;background:#252525;color:white;
border:0;border-radius:25px;
padding:14px;outline:none;
}
button{
background:white;color:black;border:0;
border-radius:25px;padding:0 20px;
font-weight:bold;
}
</style>
</head>
<body>
<header>DARK <span>CHAT</span> 🖤</header>
<div id="messages">
<div class="msg">أهلاً بك في DARK CHAT 🖤</div>
</div>
<footer>
<input id="message" placeholder="اكتب رسالتك...">
<button onclick="send()">إرسال</button>
</footer>
<script>
function send(){
const input=document.getElementById("message");
if(!input.value.trim())return;
const msg=document.createElement("div");
msg.className="msg mine";
msg.textContent=input.value;
document.getElementById("messages").appendChild(msg);
input.value="";
}
</script>
</body>
</html>
